# Copy this file to config.env and adjust. config.env is gitignored.
# Environment variables take precedence over values in config.env.

# Hostname or IP address of the Pi. Defaults to raspberrypi.local (mDNS).
#PI_HOST=raspberrypi.local

# SSH user on the Pi. Leave unset to use ssh's own default (for example the
# user in ~/.ssh/config or the Pi's first-boot user).
#PI_USER=pi

# Name the speaker advertises over AirPlay, Bluetooth, Spotify Connect and
# UPnP/DLNA.
#SPEAKER_NAME="PiZERO Speakers"

# Bluetooth mode after install: "locked" (only already-paired devices may
# connect) or "open" (discoverable and pairable).
#BT_MODE_DEFAULT=locked
