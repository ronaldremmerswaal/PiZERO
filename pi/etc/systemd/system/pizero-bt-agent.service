[Unit]
Description=Bluetooth pairing agent with lock mode (PiZERO Speakers)
After=bluetooth.service
Requires=bluetooth.service
PartOf=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/local/bin/pizero-bt-agent
Restart=always
RestartSteps=5
RestartMaxDelaySec=60
RestartSec=3

[Install]
WantedBy=multi-user.target
